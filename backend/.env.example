# ==============================================================================
# Backend Environment Configuration Template
# Copy this file to .env and populate with your local / production secrets.
# ==============================================================================

# Application Runtime
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# Worker Process Mode (Set to true on single-service hosts like Render free tier)
RUN_WORKER_IN_PROCESS=false

# PostgreSQL Database (Neon Cloud or local instance)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/url_shortener?sslmode=disable"

# Security & Authentication Secrets
SALT_ROUNDS=10
ACCESS_TOKEN_SECRET="super_secret_access_jwt_signing_key_min_32_characters"
REFRESH_TOKEN_SECRET="super_secret_refresh_jwt_signing_key_min_32_characters"
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# URL Shortcode Generator
URL_SHORTCODE_LENGTH=8

# Redis Configuration (Must include RedisBloom module, e.g., redis/redis-stack)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Cache Tuning (Cache-aside TTL in seconds & jitter percentage)
URL_CACHE_TTL=300
JITTER_PERCENT=0.1

# Distributed Lock Tuning (seconds)
LOCK_TTL_SECONDS=5

# Proactive Cache Warmer Configuration
HOT_URL_CACHE_TTL_HOURS=24
CACHE_WARMER_EVERY_MINUTES=15
WARM_HOT_URLS_LIMIT=50

# Multi-Tier Rate Limiting Configuration
GLOBAL_RATE_LIMIT_WINDOW=15
GLOBAL_RATE_LIMIT_SIZE=100
LOGIN_RATE_LIMIT_WINDOW=15
LOGIN_RATE_LIMIT_SIZE=5
SHORT_URL_TOKEN_BUCKET_CAPACITY=10
SHORT_URL_TOKEN_REFILL_RATE=1
SHORT_URL_TOKEN_REFILL_INTERVAL=2000
FORGOT_PASSWORD_RATE_LIMIT_WINDOW=15
FORGOT_PASSWORD_RATE_LIMIT_SIZE=3
RESEND_VERIFICATION_RATE_LIMIT_WINDOW=15
RESEND_VERIFICATION_RATE_LIMIT_SIZE=3

# Transactional Email (Brevo API)
BREVO_API_KEY="xkeysib-your-brevo-api-key"
BREVO_SENDER_EMAIL="noreply@yourdomain.com"
BREVO_SENDER_NAME="shortr"
EMAIL_VERIFICATION_TOKEN_EXPIRES_IN="24h"
PASSWORD_RESET_TOKEN_EXPIRES_IN="30m"
