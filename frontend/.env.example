# ==============================================================================
# Frontend Environment Configuration Template
# Copy this file to .env and configure for your environment.
# ==============================================================================

# Backend API Base URL
# In local development, leave this empty so Vite automatically proxies /api and /r to http://localhost:4000
# In production, set to your backend API domain if separated, or leave empty if served by the backend
VITE_API_URL=

# Short URL Domain Base
# Configures the domain string shown in dashboards, copy buttons, and QR codes
# Defaults to window.location.origin if unset
VITE_SHORT_URL_BASE=http://localhost:3000
